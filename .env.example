# copy to .env and adjust — oldie-blog reads plain environment variables
# (export them yourself or use your process manager; nothing is loaded automatically)

# canonical base url used for <link rel=canonical>, feeds and sitemaps
SITE_URL=https://your-site.tld

# interface and port
HOST=127.0.0.1
PORT=4173

# admin credentials. config/admin.json wins once it exists, so the first boot# creates that file from ADMIN_PASSWORD — after that, changing this variable
# here no longer changes the password (change it in the admin instead).
# The file lives in the data volume, so keep the volume and you keep the password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# signs the session cookies; generated automatically if unset
SESSION_SECRET=

# production turns on cache headers and silences the dev content watcher
NODE_ENV=development
