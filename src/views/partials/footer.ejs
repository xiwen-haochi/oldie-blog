<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <h4><%= t('footer.netscape') %></h4>
      <ul style="list-style:none;padding:0;margin:0">
        <li><a href="/feed.xml">📡 RSS 2.0</a></li>
        <li><a href="/atom.xml">📡 Atom 1.0</a></li>
        <li><a href="/feed.json">📡 JSON Feed</a></li>
        <li><a href="/sitemap.xml">🗺 sitemap.xml</a></li>
        <li><a href="/site.webmanifest">📱 web app manifest</a></li>
      </ul>
    </div>
    <div>
      <h4><%= t('footer.this_page') %></h4>
      <ul style="list-style:none;padding:0;margin:0">
        <li><a href="/posts">📝 <%= t('admin.posts').replace(/^[^ ]+ /, '') %></a></li>
        <li><a href="/archive">🗄 <%= t('archive.title').replace(/^[^ ]+ /, '') %></a></li>
        <li><a href="/tags">🏷 <%= t('tags.title').replace(/^[^ ]+ /, '') %></a></li>
        <li><a href="/search">🔍 <%= t('search.title').replace(/^[^ ]+ /, '') %></a></li>
        <li><a href="/guestbook">📬 <%= t('gb.title').replace(/^[^ ]+ /, '') %></a></li>
      </ul>
    </div>
    <div>
      <h4><%= t('footer.extras') %></h4>
      <ul style="list-style:none;padding:0;margin:0">
        <li><a href="#" data-toggle-terminal>⌨️ <%= t('footer.dos_terminal') %></a> <span class="mono">(Ctrl+K)</span></li>
        <li><a href="#" data-toggle-music>🎵 <%= t('footer.chiptune') %></a></li>
        <li><a href="#" data-toggle-theme>⏳ <%= t('footer.time_machine') %></a></li>
        <li><a href="/posts/<%= (latestPost && latestPost.slug) || 'hello-world' %>.txt" download>💾 <%= t('footer.download_latest') %></a></li>
      </ul>
    </div>
    <div>
      <h4>🌐 <%= t('side.webring') %></h4>
      <div class="webring-nav" style="justify-content:flex-start">
        <a class="btn tiny" href="<%= webringHref(-1) %>">◀ <%= t('side.prev') %></a>
        <a class="btn tiny" href="<%= webringHref(1) %>"><%= t('side.next') %> ▶</a>
        <a class="btn tiny" href="<%= webringHref(0) %>"><%= t('side.random_site') %></a>
      </div>
      <p class="mono" style="font-size:10px;margin:6px 0 0"><%= t('footer.you_are_visiting', { n: webringIndex, total: (site.webring || []).length }) %></p>
    </div>
  </div>
  <div class="divider"></div>
  <div class="legal">
    <p style="margin:0"><%= t('footer.copyright', { year: year, author: site.author }) %></p>
    <p style="margin:3px 0 0"><%= site.footer %></p>
    <p style="margin:3px 0 0" class="mono">
      <%= t('footer.hosted_on') %> <span class="blink">■</span> ·
      <%= t('footer.generated_in') %> <span id="gen-time">—</span> <%= t('footer.ms') %> ·
      <a href="/about#colophon">colophon</a>
    </p>
    <% if (site.icp) { %><p style="margin:3px 0 0" class="mono"><%= site.icp %></p><% } %>
  </div>
</footer>
