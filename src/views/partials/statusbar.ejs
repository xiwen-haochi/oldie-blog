<div class="statusbar">
  <span id="sb-status">📶 <%= t('bar.status.connecting') %></span>
  <span class="grow" id="sb-path"><%= currentPath %></span>
  <span class="mono"><%= t('bar.status.hits') %>: <span id="sb-hits"><%= stats.total %></span></span>
  <span class="mono"><%= t('bar.status.online') %>: <span id="sb-online"><%= stats.online %></span></span>
</div>
