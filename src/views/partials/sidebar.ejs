<aside class="sidebar" aria-label="Sidebar">
  <div class="widget">
    <div class="widget-body center">
      <div style="font-size:34px;line-height:1" aria-hidden="true">🖥️</div>
      <div style="font-weight:700;font-family:var(--font-display);font-size:13px"><%- '&lt;' + String(site.author).split(' ')[0] + '&gt;' %></div>
      <div class="mono" style="font-size:10px"><%= t('side.webmaster_since') %> <%= since %></div>
      <div class="mono" style="font-size:10px"><%= t('side.last_updated') %>: <%= lastUpdated %></div>
      <div style="margin-top:5px">
        <a class="btn tiny" href="mailto:<%= site.email %>">📧 <%= t('side.email_me') %></a>
      </div>
    </div>
  </div>

  <div class="widget">
    <h3 class="widget-title">🧭 <%= t('side.navigation') %></h3>
    <div class="widget-body">
      <ul class="navlist">
        <% (site.nav || []).forEach(function (item, i) { %>
        <li>
          <a href="<%= item.href %>"<%= currentPath === item.href ? ' aria-current="page"' : '' %>><%= item.label %></a>
          <span class="key"><%= i + 1 %></span>
        </li>
        <% }) %>
        <li><a href="/random" title="<%= t('side.random') %>">🎲 <%= t('side.random') %></a></li>
        <li><a href="/sitemap.xml" class="mono">🗺 <%= t('side.sitemap') %></a></li>
      </ul>
    </div>
  </div>

  <% if (site.theme.showCounter) { %>
  <div class="widget">
    <h3 class="widget-title">📊 <%= t('side.visitor') %></h3>
    <div class="widget-body">
      <div class="counter-display" id="hit-counter" aria-label="<%= t('side.visitor') %> <%= stats.total %>">
        <% String(stats.total).padStart(8, '0').split('').forEach(function (d) { %><span class="digit"><%= d %></span><% }) %>
      </div>
      <div class="counter-label">
        <span id="hit-session">#<%= stats.sessionRank %></span> <%= t('side.this_visit') %> ·
        <%= t('side.today') %> <span id="hit-today"><%= stats.today %></span>
      </div>
      <div class="counter-label mono" style="font-size:9.5px">
        <%= t('side.unique') %>: <span id="hit-unique"><%= stats.unique %></span> ·
        <%= t('side.uptime') %> <span id="hit-uptime">—</span>
      </div>
    </div>
  </div>
  <% } %>

  <% if ((site.webring || []).length) { %>
  <div class="widget">
    <h3 class="widget-title">🌐 <%= t('side.webring') %></h3>
    <div class="widget-body">
      <ul>
        <% site.webring.slice(0, 5).forEach(function (m) { %>
        <li><a href="<%= m.url %>" target="_blank" rel="noopener"><%= m.title %></a></li>
        <% }) %>
      </ul>
      <div class="webring-nav" style="margin-top:6px">
        <a class="btn tiny" href="<%= webringHref(-1) %>" rel="prev">◀ <%= t('side.prev') %></a>
        <span class="ring-label">RING</span>
        <a class="btn tiny" href="<%= webringHref(1) %>" rel="next"><%= t('side.next') %> ▶</a>
        <a class="btn tiny" href="<%= webringHref(0) %>" rel="random"><%= t('side.random_site') %></a>
      </div>
      <div class="counter-label mono" style="font-size:9.5px"><%= t('side.members') %>: <%= (site.webring || []).length %></div>
    </div>
  </div>
  <% } %>


  <div class="widget">
    <h3 class="widget-title">📬 <%= t('side.guestbook') %></h3>
    <div class="widget-body">
      <% if (latestGuestbook) { %>
        <div style="border-bottom:1px dotted #808080;padding-bottom:5px;margin-bottom:5px">
          <strong><%= latestGuestbook.name %></strong>
          <span class="mono" style="font-size:10px">(<%= latestGuestbook.location || 'the World Wide Web' %>)</span>
          <div style="font-size:11px">“<%= truncate(latestGuestbook.message, 90) %>”</div>
        </div>
      <% } %>
      <a class="btn tiny" href="/guestbook">✍️ <%= t('side.sign_it') %></a>
      <a class="btn tiny" href="/guestbook#entries"><%= t('side.read_all') %> (<%= guestbookCount %>)</a>
    </div>
  </div>


  <div class="widget">
    <div class="widget-body center" style="font-size:10px">
      <span class="blink">★</span> <%= t('side.best_viewed') %> <span class="blink">★</span><br>
      <a href="#main" onclick="return false" class="mono" data-scroll-top>▲ <%= t('side.back_to_top') %></a>
    </div>
  </div>
</aside>
