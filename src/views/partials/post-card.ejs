<li>
  <h3>
    <% if (post.draft) { %><span class="stamp draft">DRAFT</span> <% } %>
    <% if (post.featured) { %><span class="stamp featured">FEATURED</span> <% } %>
    <a href="<%= post.url %>"><%= post.title %></a>
  </h3>
  <div class="post-meta">
    <span>📅 <%= formatDate(post.date, { locale: site.locale }) %></span>
    <span>⏱ <%= post.readingTime %> min</span>
    <span>🔤 <%= post.wordCount %></span>
    <% post.tags.slice(0, 4).forEach(function (t) { %>
      <a class="tag" href="/tags/<%= slugify(t) %>"><%= t %></a>
    <% }) %>
  </div>
  <p class="post-excerpt"><%= post.description %></p>
  <div class="linkbar">
    <a class="btn tiny" href="<%= post.url %>">▶ READ MORE</a>
    <a class="btn tiny" href="<%= post.url %>.txt" download>💾 .TXT</a>
    <a class="btn tiny" href="<%= post.url %>#comments">💬 COMMENTS</a>
  </div>
</li>
