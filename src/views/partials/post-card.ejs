<li>
  <h3>
    <% if (post.draft) { %><span class="stamp draft"><%= t('card.draft') %></span> <% } %>
    <% if (post.featured) { %><span class="stamp featured"><%= t('card.featured') %></span> <% } %>
    <a href="<%= post.url %>"><%= post.title %></a>
  </h3>
  <div class="post-meta">
    <span>📅 <%= formatDate(post.date, { locale: dateLocale }) %></span>
    <span>⏱ <%= post.readingTime %> <%= t('card.min') %></span>
    <span>🔤 <%= post.wordCount %></span>
    <% post.tags.slice(0, 4).forEach(function (tag) { %>
      <a class="tag" href="/tags/<%= slugify(tag) %>"><%= tag %></a>
    <% }) %>
  </div>
  <p class="post-excerpt"><%= post.description %></p>
  <div class="linkbar">
    <a class="btn tiny" href="<%= post.url %>">▶ <%= t('card.read_more') %></a>
    <a class="btn tiny" href="<%= post.url %>.txt" download>💾 <%= t('card.txt') %></a>
    <a class="btn tiny" href="<%= post.url %>#comments">💬 <%= t('card.comments') %></a>
  </div>
</li>
