<div class="titlebar">
  <span class="tb-icon" aria-hidden="true">🖥</span>
  <span class="tb-title" id="tb-title"><%= page.windowTitle || site.title %></span>
  <span class="tb-text" id="tb-url"><%= site.url.replace(/^https?:\/\//, '') %><%= currentPath %></span>
  <nav class="tb-lang" aria-label="<%= t('bar.language') %>">
    <% langs.forEach(function (l) { %>
      <a href="<%= langSwitchUrl(l.code) %>" hreflang="<%= l.code %>" lang="<%= l.code %>"<%= l.code === locale ? ' aria-current="true" class="on"' : '' %>><%= l.label %></a>
    <% }) %>
  </nav>
</div>
<div class="utility-bar">
  <a href="/" class="mono"><%= t('bar.home') %></a>
  <span class="sep" aria-hidden="true"></span>
  <a href="/feed.xml" class="mono"><%= t('bar.rss') %></a>
  <a href="/search" class="mono"><%= t('bar.find') %>…</a>
  <a href="#" data-toggle-theme class="mono"><%= t('bar.theme') %></a>
  <span class="sep" aria-hidden="true"></span>
  <span class="mono muted" id="tb-clock"><%= t('bar.status.hits') %> <%= stats.total %></span>
</div>
