<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= page.fullTitle %></title>
<meta name="description" content="<%= page.description %>">
<% if ((page.keywords || []).length) { %><meta name="keywords" content="<%= page.keywords.join(', ') %>"><% } %>
<meta name="author" content="<%= page.author || site.author %>">
<meta name="robots" content="<%= page.robots %>">
<meta name="generator" content="oldie-blog">
<link rel="canonical" href="<%= page.canonicalUrl %>">
<% (typeof alternates !== 'undefined' ? alternates : []).forEach(function (alt) { %>
<link rel="alternate" hreflang="<%= alt.code %>" href="<%= alt.code === locale ? page.canonicalUrl : absUrl(site, alt.href) %>">
<% }) %>
<% (typeof alternates !== 'undefined' ? alternates : []).forEach(function (alt) { %>
<% if (alt.current) { %><link rel="alternate" hreflang="<%= alt.code %>" href="<%= absUrl(site, alt.href) %>">
<% } else { %><link rel="alternate" hreflang="<%= alt.code %>" href="<%= absUrl(site, alt.href) %>">
<% } %>
<% }) %>
<% if (page.prevUrl) { %><link rel="prev" href="<%= page.prevUrl %>">
<% } %><% if (page.nextUrl) { %><link rel="next" href="<%= page.nextUrl %>">
<% } %>
<meta property="og:type" content="<%= page.type %>">
<meta property="og:site_name" content="<%= site.title %>">
<meta property="og:title" content="<%= page.title || site.title %>">
<meta property="og:description" content="<%= page.description %>">
<meta property="og:url" content="<%= page.canonicalUrl %>">
<meta property="og:image" content="<%= page.ogImage %>">
<meta property="og:image:alt" content="<%= page.title || site.title %>">
<meta property="og:locale" content="<%= String(localeMeta.htmlLang).replace('-', '_') %>">
<% (typeof alternates !== 'undefined' ? alternates : []).forEach(function (alt) { %><meta property="og:locale:alternate" content="<%= String(alt.code).replace('-', '_') %>">
<% }) %>
<% if (page.publishedAt) { %><meta property="article:published_time" content="<%= page.publishedAt %>">
<% } %><% if (page.updatedAt) { %><meta property="article:modified_time" content="<%= page.updatedAt %>">
<% } %><% (page.tags || []).slice(0, 6).forEach(function (t) { %><meta property="article:tag" content="<%= t %>">
<% }) %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page.title || site.title %>">
<meta name="twitter:description" content="<%= page.description %>">
<meta name="twitter:image" content="<%= page.ogImage %>">
<link rel="alternate" type="application/rss+xml" title="<%= site.title %> — RSS 2.0" href="/feed.xml">
<link rel="alternate" type="application/atom+xml" title="<%= site.title %> — Atom 1.0" href="/atom.xml">
<link rel="alternate" type="application/feed+json" title="<%= site.title %> — JSON Feed" href="/feed.json">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icon-192.svg">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="<%= site.theme.accent2 || '#000080' %>">
<meta name="csrf-token" content="<%= csrf %>">
<meta name="color-scheme" content="light">
<link rel="stylesheet" href="/css/site.css?v=<%= site.assetV %>">
<link rel="stylesheet" href="/css/vendor/hljs.css?v=<%= site.assetV %>">
<% (page.jsonLd || []).forEach(function (ld) { %>
<script type="application/ld+json"><%- JSON.stringify(ld) %></script>
<% }) %>
