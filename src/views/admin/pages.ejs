<div class="admin-head">
  <h1>📄 Pages</h1>
  <a class="btn primary" href="/admin/pages/new">📄 NEW PAGE</a>
</div>
<p class="form-note">Pages are Markdown files in <code>content/pages/</code> served at <code>/&lt;slug&gt;</code>. Useful for About, Colophon, Links…</p>
<table class="table">
  <thead><tr><th>Page</th><th>Updated</th><th>Words</th><th class="nowrap">Actions</th></tr></thead>
  <tbody>
    <% pages.forEach(function (p) { %>
      <tr>
        <td><a href="/admin/pages/<%= p.slug %>/edit"><strong><%= p.title %></strong></a><div class="mono muted" style="font-size:11px">/&lt;%= p.slug %&gt; · content/pages/<%= p.file %></div></td>
        <td class="mono" style="font-size:11.5px"><%= formatDate(p.updated || p.date, { style: 'short' }) %></td>
        <td><%= p.wordCount %></td>
        <td class="nowrap">
          <a class="btn tiny" href="/admin/pages/<%= p.slug %>/edit">✏️</a>
          <a class="btn tiny" href="/<%= p.slug %>" target="_blank" rel="noopener">👁</a>
          <form method="post" action="/admin/pages/<%= p.slug %>/delete" class="inline-form" data-confirm="Delete the page file <%= p.file %>?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn tiny danger" type="submit">🗑</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!pages.length) { %><tr><td colspan="4" class="muted">No pages yet. Create one or drop a .md file into content/pages/.</td></tr><% } %>
  </tbody>
</table>
