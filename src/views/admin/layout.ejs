<!DOCTYPE html>
<html lang="<%= localeMeta.htmlLang %>" data-theme="admin">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> · <%= site.title %></title>
<meta name="csrf-token" content="<%= csrf %>">
<meta name="csrf-token" content="<%= csrf %>">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/site.css?v=<%= site.assetV %>">
<link rel="stylesheet" href="/css/admin.css?v=<%= site.assetV %>">
<link rel="stylesheet" href="/css/vendor/hljs.css">
</head>
<body class="admin-body">
<div class="admin-window">
  <div class="titlebar">
    <span class="tb-icon" aria-hidden="true">🗄</span>
    <span class="tb-title"><%= t('admin.control_panel') %> — <%= title %></span>
    <nav class="tb-lang" aria-label="<%= t('bar.language') %>">
      <% langs.forEach(function (l) { %>
        <a href="<%= langSwitchUrl(l.code) %>" hreflang="<%= l.code %>" lang="<%= l.code %>"<%= l.code === locale ? ' aria-current="true" class="on"' : '' %>><%= l.label %></a>
      <% }) %>
    </nav>
  </div>
  <div class="admin-shell">
    <nav class="admin-nav" aria-label="Admin sections">
      <div class="admin-nav-head"><%= t('admin.site_control') %></div>
      <ul>
        <% nav.forEach(function (item) { %>
          <li><a href="<%= item.href %>"<%= (req && req.path === item.href) ? ' aria-current="page"' : '' %>><%= item.label %></a></li>
        <% }) %>
      </ul>
      <div class="admin-nav-foot">
        <div class="mono">node <%= process.versions.node %></div>
        <div class="mono"><%= t('admin.uptime') %> <%= Math.floor(process.uptime() / 60) %>m</div>
        <form method="post" action="<%= adminPath %>/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn tiny" type="submit"><%= t('admin.logout') %></button>
        </form>
      </div>
    </nav>
    <main class="admin-main">
      <div class="admin-breadcrumb">
        <span class="mono">C:\OLDIESITE\ADMIN\<%= String(title).toUpperCase().replace(/\s+/g, '_') %>.EXE</span>
      </div>
      <% if (flash) { %>
        <div class="alert <%= flash.type %>" role="status"><%= flash.text %></div>
      <% } %>
      <%- body %>
    </main>
  </div>
  <div class="statusbar">
    <span><%= t('admin.ready') %></span>
    <span class="grow mono">oldie-blog admin · content/*.md</span>
    <span class="mono">site: <%= site.url.replace(/^https?:\/\//, '') %></span>
  </div>
</div>
<div class="dock" aria-label="Desktop shortcuts">
  <button type="button" onclick="location.href='/'"><span class="ico" aria-hidden="true">🌐</span><span><%= t('admin.view_site').replace(/^[^ ]+ /, '') %></span></button>
</div>
<script id="i18n-admin" type="application/json"><%- JSON.stringify(clientStrings) %></script>
<script src="/js/admin.js?v=<%= site.assetV %>" defer></script>
</body>
</html>
