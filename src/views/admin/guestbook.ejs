<div class="admin-head">
  <h1>📬 <%= t('admin.guestbook') %></h1>
  <div class="btn-row">
    <span class="stamp"><%= stats.approved %> ✓</span>
    <span class="stamp draft"><%= stats.pending %></span>
    <span class="stamp"><%= stats.spam %></span>
    <span class="stamp"><%= stats.comments %></span>
  </div>
</div>

<form class="filter-bar" method="get" action="<%= adminPath %>/guestbook">
  <input type="hidden" name="lang" value="<%= locale %>">
  <select name="status">
    <option value="all" <%= status === 'all' ? 'selected' : '' %>><%= t('admin.all') %></option>
    <option value="approved" <%= status === 'approved' ? 'selected' : '' %>><%= t('admin.live') %></option>
    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>><%= t('card.draft') %></option>
    <option value="spam" <%= status === 'spam' ? 'selected' : '' %>><%= t('admin.spam') %></option>
  </select>
  <button class="btn" type="submit"><%= t('admin.filter') %></button>
  <a class="btn ghost" href="/guestbook" target="_blank" rel="noopener">👁</a>
</form>

<% if (!entries.length) { %><div class="alert"><%= t('admin.queue_empty') %></div><% } %>

<% entries.forEach(function (e) { %>
  <div class="gb-entry <%= e.status === 'approved' ? '' : 'pending' %>">
    <div class="gb-head">
      <span class="who">📝 <%= e.name %></span>
      <span class="stamp-time">#<%= e.id %> · <%= e.target %> · <%= e.location || 'unknown' %> · <%= formatDate(e.date, { locale: dateLocale }) %></span>
    </div>
    <div class="gb-body"><%= e.message %></div>
    <div class="gb-meta">
      <% if (e.email) { %>📧 <a href="mailto:<%= e.email %>"><%= e.email %></a> · <% } %>
      <% if (e.url) { %>🌐 <a href="<%= e.url %>" rel="nofollow noopener" target="_blank"><%= e.host %></a> · <% } %>
      <span class="mono"><%= e.ip || '—' %></span>
    </div>
    <div class="gb-actions">
      <% if ((e.status || 'approved') !== 'approved') { %>
        <form method="post" action="<%= adminPath %>/guestbook/<%= e.id %>/status?status=<%= status %>" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="approved">
          <button class="btn tiny" type="submit"><%= t('admin.approve') %></button>
        </form>
      <% } %>
      <form method="post" action="<%= adminPath %>/guestbook/<%= e.id %>/status?status=<%= status %>" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="status" value="<%= (e.status || 'approved') === 'spam' ? 'approved' : 'spam' %>">
        <button class="btn tiny" type="submit"><%= (e.status || 'approved') === 'spam' ? '↩' : t('admin.spam') %></button>
      </form>
      <form method="post" action="<%= adminPath %>/guestbook/<%= e.id %>/delete" class="inline-form" data-confirm="<%= t('admin.delete_confirm', { slug: '#' + e.id }) %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn tiny danger" type="submit">✖ <%= t('admin.delete') %></button>
      </form>
    </div>
  </div>
<% }) %>
