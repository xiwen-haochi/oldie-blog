<div class="admin-head">
  <h1>📝 <%= t('admin.posts') %></h1>
  <div class="btn-row">
    <a class="btn primary" href="<%= adminPath %>/posts/new"><%= t('admin.new_post') %></a>
    <a class="btn" href="<%= adminPath %>/pages"><%= t('admin.pages') %></a>
  </div>
</div>

<form class="filter-bar" method="get" action="<%= adminPath %>/posts">
  <input type="hidden" name="lang" value="<%= locale %>">
  <input type="search" name="q" value="<%= q %>" placeholder="<%= t('admin.filter_placeholder') %>">
  <select name="filter">
    <option value="all" <%= filter === 'all' ? 'selected' : '' %>><%= t('admin.all') %> (<%= counts.all %>)</option>
    <option value="published" <%= filter === 'published' ? 'selected' : '' %>><%= t('admin.live') %> (<%= counts.published %>)</option>
    <option value="draft" <%= filter === 'draft' ? 'selected' : '' %>><%= t('card.draft') %> (<%= counts.draft %>)</option>
    <option value="featured" <%= filter === 'featured' ? 'selected' : '' %>>★ (<%= counts.featured %>)</option>
  </select>
  <button class="btn" type="submit"><%= t('admin.filter') %></button>
  <a class="btn ghost" href="<%= adminPath %>/posts"><%= t('admin.reset') %></a>
</form>

<table class="table post-table">
  <thead>
    <tr><th><%= t('admin.title_col') %></th><th><%= t('admin.date_col') %></th><th>Tags</th><th><%= t('admin.status_col') %></th><th class="nowrap"><%= t('admin.actions') %></th></tr>
  </thead>
  <tbody>
    <% posts.forEach(function (p) { %>
      <tr>
        <td>
          <a href="<%= adminPath %>/posts/<%= p.slug %>/edit"><strong><%= p.title %></strong></a>
          <div class="mono muted" style="font-size:11px">/posts/&lt;%= p.slug %&gt; · <%= p.wordCount %> · <%= p.readingTime %> <%= t('card.min') %></div>
        </td>
        <td class="mono" style="font-size:11.5px"><%= formatDate(p.date, { locale: dateLocale }) %></td>
        <td><% p.tags.forEach(function (tag) { %><span class="stamp" style="background:#c0c0c0;color:#000"><%= tag %></span> <% }) %></td>
        <td class="nowrap">
          <% if (p.draft) { %><span class="stamp draft"><%= t('card.draft') %></span><% } else { %><span class="stamp featured"><%= t('admin.live') %></span><% } %>
          <% if (p.featured) { %><span class="stamp">★</span><% } %>
          <% if (p.noindex) { %><span class="stamp">NOINDEX</span><% } %>
        </td>
        <td class="nowrap">
          <a class="btn tiny" href="<%= adminPath %>/posts/<%= p.slug %>/edit" title="<%= t('admin.edit') %>">✏️</a>
          <a class="btn tiny" href="/posts/<%= p.slug %>" target="_blank" rel="noopener" title="<%= t('admin.view') %>">👁</a>
          <form method="post" action="<%= adminPath %>/posts/<%= p.slug %>/duplicate" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn tiny" type="submit" title="<%= t('admin.duplicate') %>">⧉</button>
          </form>
          <form method="post" action="<%= adminPath %>/posts/<%= p.slug %>/delete" class="inline-form" data-confirm="<%= t('admin.delete_confirm', { slug: p.slug }) %>">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn tiny danger" type="submit">🗑</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!posts.length) { %><tr><td colspan="5" class="muted">—</td></tr><% } %>
  </tbody>
</table>
