<div class="admin-head">
  <h1>📊 <%= t('admin.dashboard') %></h1>
  <div class="btn-row">
    <a class="btn primary" href="<%= adminPath %>/posts/new"><%= t('admin.new_post') %></a>
    <a class="btn" href="<%= adminPath %>/pages/new"><%= t('admin.new_page') %></a>
    <a class="btn" href="<%= adminPath %>/tools"><%= t('admin.tools') %></a>
    <a class="btn" href="/"><%= t('admin.view_site') %></a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card"><div class="stat-value"><%= stats.total %></div><div class="stat-label"><%= t('admin.hits') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= stats.today %></div><div class="stat-label"><%= t('admin.today') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= stats.unique %></div><div class="stat-label"><%= t('admin.unique_today') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= stats.online %></div><div class="stat-label"><%= t('admin.online_now') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= ctx.index.publishedPosts().length %></div><div class="stat-label"><%= t('admin.published') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= drafts.length %></div><div class="stat-label"><%= t('admin.drafts') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= ctx.index.totalWords().toLocaleString('en-US') %></div><div class="stat-label"><%= t('admin.words') %></div></div>
  <div class="stat-card"><div class="stat-value"><%= community.approved %></div><div class="stat-label"><%= t('admin.guestbook_signed') %></div></div>
</div>

<div class="admin-cols">
  <section class="admin-panel">
    <h2 class="widget-title"><%= t('admin.last_30') %></h2>
    <div class="spark" role="img" aria-label="Daily hits for the last 30 days">
      <% const max = Math.max(1, ...series.map(function (d) { return d.count; })); %>
      <% series.forEach(function (d) { %>
        <span class="spark-bar" style="height:<%= Math.max(2, Math.round((d.count / max) * 100)) %>%" title="<%= d.date %>: <%= d.count %>"></span>
      <% }) %>
    </div>
    <p class="form-note"><%= t('admin.peak', { n: stats.best, paths: stats.paths }) %></p>
  </section>

  <section class="admin-panel">
    <h2 class="widget-title"><%= t('admin.seo_health', { score: seo.score }) %></h2>
    <ul class="check-list">
      <% seo.checks.forEach(function (c) { %>
        <li class="<%= c.ok ? 'ok' : 'warn' %>"><span class="mark"><%= c.ok ? '✔' : '!' %></span> <strong><%= c.label %></strong><br><span class="muted mono" style="font-size:11px"><%= c.detail %></span></li>
      <% }) %>
    </ul>
  </section>

  <section class="admin-panel">
    <h2 class="widget-title"><%= t('admin.latest_posts') %></h2>
    <table class="table">
      <thead><tr><th><%= t('admin.title_col') %></th><th><%= t('admin.date_col') %></th><th><%= t('admin.status_col') %></th><th></th></tr></thead>
      <tbody>
        <% recent.forEach(function (p) { %>
          <tr>
            <td><a href="<%= adminPath %>/posts/<%= p.slug %>/edit"><%= p.title %></a><div class="mono muted" style="font-size:11px">/posts/<%= p.slug %></div></td>
            <td class="mono" style="font-size:11px"><%= formatDate(p.date, { locale: dateLocale }) %></td>
            <td><%- p.draft ? '<span class="stamp draft">' + t('card.draft') + '</span>' : '<span class="stamp featured">' + t('admin.live') + '</span>' %><%- p.featured ? ' <span class="stamp">★</span>' : '' %></td>
            <td class="nowrap"><a class="btn tiny" href="<%= adminPath %>/posts/<%= p.slug %>/edit"><%= t('admin.edit') %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section class="admin-panel">
    <h2 class="widget-title"><%= t('admin.queue') %> <%= queue.length %></h2>
    <% if (!queue.length) { %>
      <p class="form-note"><%= t('admin.queue_empty') %></p>
    <% } %>
    <% queue.forEach(function (e) { %>
      <div class="gb-entry pending">
        <div class="gb-head"><span><%= e.name %></span><span class="stamp-time"><%= e.location || 'unknown' %></span></div>
        <div class="gb-body"><%= truncate(e.message, 160) %></div>
        <div class="gb-meta btn-row">
          <form method="post" action="<%= adminPath %>/guestbook/<%= e.id %>/status" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="approved">
            <button class="btn tiny" type="submit"><%= t('admin.approve') %></button>
          </form>
          <form method="post" action="<%= adminPath %>/guestbook/<%= e.id %>/status" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="spam">
            <button class="btn tiny" type="submit"><%= t('admin.spam') %></button>
          </form>
        </div>
      </div>
    <% }) %>
    <p><a class="btn tiny" href="<%= adminPath %>/guestbook">→</a></p>
  </section>

  <section class="admin-panel">
    <h2 class="widget-title"><%= t('admin.top_paths') %></h2>
    <table class="table">
      <thead><tr><th><%= t('admin.path') %></th><th><%= t('admin.hits') %></th></tr></thead>
      <tbody>
        <% top.forEach(function (row) { %>
          <tr><td class="mono" style="font-size:11.5px"><a href="<%= row.path %>"><%= row.path %></a></td><td><%= row.count %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section class="admin-panel">
    <h2 class="widget-title"><%= t('admin.system') %></h2>
    <table class="table">
      <tbody>
        <tr><td>node</td><td class="mono"><%= node %></td></tr>
        <tr><td><%= t('admin.uptime') %></td><td class="mono"><%= uptime %>s</td></tr>
        <tr><td><%= t('admin.memory') %></td><td class="mono"><%= Math.round(process.memoryUsage().rss / 1048576) %> MB</td></tr>
        <tr><td><%= t('admin.posts_pages') %></td><td class="mono"><%= ctx.index.allPosts().length %> / <%= ctx.index.pages.length %></td></tr>
        <tr><td><%= t('admin.subscribers') %></td><td class="mono"><%= ctx.community.subscriberCount() %></td></tr>
        <tr><td><%= t('admin.since') %></td><td class="mono"><%= site.since || '1998' %></td></tr>
      </tbody>
    </table>
  </section>
</div>
