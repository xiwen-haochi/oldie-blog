<div class="admin-head">
  <h1>⚙ <%= t('admin.settings_title') %></h1>
  <div class="btn-row">
    <button class="btn primary" type="submit" form="settings-form">💾 <%= t('admin.save') %></button>
    <form method="post" action="<%= adminPath %>/settings/reset" class="inline-form" data-confirm="<%= t('admin.settings_reset') %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit"><%= t('admin.reset_config') %></button>
    </form>
  </div>
</div>

<div class="alert warn"><%= t('admin.settings_note') %></div>

<form id="settings-form" method="post" action="<%= adminPath %>/settings" class="settings-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="lang" value="<%= locale %>">

  <fieldset>
    <legend><%= t('admin.features') %></legend>
    <label class="checkline"><input type="checkbox" name="fComments" <%= settings.features.comments ? 'checked' : '' %>> 💬 <%= t('admin.f_comments') %></label>
    <label class="checkline"><input type="checkbox" name="fModerateComments" <%= settings.features.moderateComments ? 'checked' : '' %>> ⏳ <%= t('admin.f_moderate_comments') %></label>
    <label class="checkline"><input type="checkbox" name="fGuestbook" <%= settings.features.guestbook ? 'checked' : '' %>> 📬 <%= t('admin.f_guestbook') %></label>
    <label class="checkline"><input type="checkbox" name="fModerateGuestbook" <%= settings.features.moderateGuestbook ? 'checked' : '' %>> 🕒 <%= t('admin.f_moderate_guestbook') %></label>
    <label class="checkline"><input type="checkbox" name="fSearch" <%= settings.features.search ? 'checked' : '' %>> 🔍 <%= t('admin.f_search') %></label>
    <label class="checkline"><input type="checkbox" name="fHitCounter" <%= settings.features.hitCounter ? 'checked' : '' %>> 📊 <%= t('admin.f_counter') %></label>
    <label class="checkline"><input type="checkbox" name="fRandomPost" <%= settings.features.randomPost ? 'checked' : '' %>> 🎲 <%= t('admin.f_random') %></label>
    <label class="checkline"><input type="checkbox" name="fShowToc" <%= settings.features.showToc ? 'checked' : '' %>> 📑 <%= t('admin.f_toc') %></label>
    <label class="checkline"><input type="checkbox" name="fShowReadingTime" <%= settings.features.showReadingTime ? 'checked' : '' %>> ⏱ <%= t('admin.f_reading') %></label>
  </fieldset>

  <fieldset>
    <legend>🗄 <%= t('admin.storage') %></legend>
    <p class="form-note"><%= t('admin.storage_hint') %></p>
    <label class="checkline"><input type="checkbox" name="s3Enabled" <%= settings.storage.driver === 's3' ? 'checked' : '' %>> ☁️ <%= t('admin.storage_s3') %></label>
    <div class="grid-2">
      <div class="field"><label for="directory"><%= t('admin.storage_dir') %></label><input id="directory" name="directory" value="<%= settings.storage.directory %>" placeholder="public/uploads"></div>
      <div class="field"><label for="publicPath"><%= t('admin.storage_public') %></label><input id="publicPath" name="publicPath" value="<%= settings.storage.publicPath %>" placeholder="/uploads"></div>
      <div class="field"><label for="dataDriver"><%= t('admin.data_driver') %></label>
        <select id="dataDriver" name="dataDriver" data-needs-restart>
          <option value="json" <%= (settings.dataDriver || 'json') === 'json' ? 'selected' : '' %>><%= t('admin.driver_json') %></option>
          <option value="sqlite" <%= settings.dataDriver === 'sqlite' ? 'selected' : '' %>><%= t('admin.driver_sqlite') %></option>
        </select>
        <div class="form-note"><%= t('admin.data_driver_hint') %></div>
      </div>
      <div class="field"><label for="maxSizeMb"><%= t('admin.storage_size') %> (MB)</label><input id="maxSizeMb" name="maxSizeMb" type="number" min="1" max="50" value="<%= settings.storage.maxSizeMb %>"></div>
      <div class="field"><label for="region"><%= t('admin.s3_region') %></label><input id="region" name="region" value="<%= settings.storage.s3.region %>" placeholder="auto"><div class="form-note"><%= t('admin.s3_region_hint') %></div></div>
      <div class="field"><label for="bucket">Bucket</label><input id="bucket" name="bucket" value="<%= settings.storage.s3.bucket %>" placeholder="my-blog-assets"></div>
      <div class="field"><label for="endpoint">Endpoint</label><input id="endpoint" name="endpoint" value="<%= settings.storage.s3.endpoint %>" placeholder="oss-cn-shanghai.aliyuncs.com"><div class="form-note"><%= t('admin.s3_endpoint_hint') %></div></div>
      <div class="field"><label for="prefix">Prefix</label><input id="prefix" name="prefix" value="<%= settings.storage.s3.prefix %>" placeholder="blog"></div>
      <div class="field"><label for="publicUrl"><%= t('admin.s3_public') %></label><input id="publicUrl" name="publicUrl" value="<%= settings.storage.s3.publicUrl %>" placeholder="https://cdn.example.com"></div>
      <div class="field"><label for="accessKeyId">Access Key ID</label><input id="accessKeyId" name="accessKeyId" value="<%= settings.storage.s3.accessKeyId %>" autocomplete="off"></div>
      <div class="field"><label for="secretAccessKey">Secret Access Key</label><input id="secretAccessKey" name="secretAccessKey" type="password" value="<%= settings.storage.s3.secretAccessKey %>" autocomplete="new-password" placeholder="<%= settings.storage.s3.secretAccessKey ? '••••••（留空保持不变）' : '' %>"></div>
    </div>
    <label class="checkline"><input type="checkbox" name="pathStyle" <%= settings.storage.s3.pathStyle ? 'checked' : '' %>> <%= t('admin.s3_pathstyle') %></label>
  </fieldset>

  <fieldset>
    <legend><%= t('admin.identity') %></legend>
    <div class="grid-2">
      <div class="field"><label for="title"><%= t('admin.site_title') %></label><input id="title" name="title" value="<%= settings.title %>" required></div>
      <div class="field"><label for="tagline"><%= t('admin.tagline') %></label><input id="tagline" name="tagline" value="<%= settings.tagline %>"></div>
    </div>
    <div class="field"><label for="description"><%= t('admin.meta_description') %></label><textarea id="description" name="description" rows="2"><%= settings.description %></textarea></div>
    <div class="grid-2">
      <div class="field"><label for="author"><%= t('admin.author') %></label><input id="author" name="author" value="<%= settings.author %>"></div>
      <div class="field"><label for="email"><%= t('admin.email') %></label><input id="email" name="email" type="email" value="<%= settings.email %>"></div>
      <div class="field"><label for="since"><%= t('admin.since') %></label><input id="since" name="since" value="<%= settings.since || '' %>"></div>
      <div class="field"><label for="url"><%= t('admin.canonical_url') %></label><input id="url" name="url" value="<%= settings.url %>"></div>
      <div class="field">
        <label for="locale"><%= t('admin.locale') %></label>
        <select id="locale" name="locale">
          <% langs.forEach(function (l) { %>
            <option value="<%= l.code %>" <%= settings.locale === l.code ? 'selected' : '' %>><%= l.label %></option>
          <% }) %>
        </select>
        <div class="form-note">zh-CN · en</div>
      </div>
      <div class="field"><label for="postsPerPage"><%= t('admin.per_page') %></label><input id="postsPerPage" name="postsPerPage" type="number" min="1" max="50" value="<%= settings.postsPerPage %>"></div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t('admin.navigation') %></legend>
    <div class="field"><textarea name="nav" rows="7" class="mono"><%= (settings.nav || []).map(function (n) { return n.label + ' | ' + n.href; }).join('\n') %></textarea></div>
  </fieldset>

  <fieldset>
    <legend><%= t('admin.webring') %></legend>
    <div class="field"><textarea name="webring" rows="6" class="mono"><%= (settings.webring || []).map(function (m) { return m.title + ' | ' + m.url + (m.note ? ' # ' + m.note : ''); }).join('\n') %></textarea></div>
  </fieldset>

  <fieldset>
    <legend><%= t('admin.banners') %></legend>
    <div class="field"><textarea name="banners" rows="4" class="mono"><%= (settings.banners || []).map(function (b) { return b.text + ' | ' + (b.href || '#'); }).join('\n') %></textarea></div>
  </fieldset>

  <fieldset>
    <legend><%= t('admin.appearance') %></legend>
    <div class="grid-2">
      <div class="field"><label for="accent"><%= t('admin.accent') %></label><input id="accent" name="accent" type="color" value="<%= settings.theme.accent || '#008080' %>"></div>
      <div class="field"><label for="accent2"><%= t('admin.accent2') %></label><input id="accent2" name="accent2" type="color" value="<%= settings.theme.accent2 || '#000080' %>"></div>
    </div>
    <label class="checkline"><input type="checkbox" name="showMarquee" <%= settings.theme.showMarquee ? 'checked' : '' %>> <%= t('admin.show_marquee') %></label>
    <label class="checkline"><input type="checkbox" name="showTerminal" <%= settings.theme.showTerminal ? 'checked' : '' %>> <%= t('admin.show_terminal') %></label>
    <label class="checkline"><input type="checkbox" name="showCounter" <%= settings.theme.showCounter ? 'checked' : '' %>> <%= t('admin.show_counter') %></label>
    <div class="field"><label for="footer"><%= t('admin.footer_text') %></label><input id="footer" name="footer" value="<%= settings.footer %>"></div>
    <div class="field"><label for="icp"><%= t('admin.icp') %></label><input id="icp" name="icp" value="<%= settings.icp || '' %>"></div>
    <div class="field">
      <label for="analytics"><%= t('admin.analytics') %></label>
      <textarea id="analytics" name="analytics" rows="3" class="mono" placeholder="&lt;script&gt;…&lt;/script&gt;"><%= settings.analytics || '' %></textarea>
      <div class="form-note"><%= t('admin.analytics_hint') %></div>
    </div>
  </fieldset>
</form>

<fieldset style="margin-top:14px">
  <legend><%= t('admin.password') %></legend>
  <form method="post" action="<%= adminPath %>/password" class="grid-2">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="current"><%= t('admin.current_password') %></label><input id="current" name="current" type="password" autocomplete="current-password" required></div>
    <div class="field"><label for="next"><%= t('admin.new_password') %></label><input id="next" name="next" type="password" autocomplete="new-password" required minlength="10"></div>
    <div class="field"><label for="confirm"><%= t('admin.repeat_password') %></label><input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="10"></div>
    <div class="field"><label>&nbsp;</label><button class="btn" type="submit"><%= t('admin.update_password') %></button></div>
  </form>
  <div class="form-note"><%= t('admin.password_hint') %></div>
</fieldset>
