<!DOCTYPE html>
<html lang="<%= localeMeta.htmlLang %>" data-theme="admin">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= t('admin.sign_in') %> · <%= site.title %></title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/site.css?v=<%= site.assetV %>">
<link rel="stylesheet" href="/css/admin.css?v=<%= site.assetV %>">
</head>
<body class="admin-body login-body">
<div class="login-window">
  <div class="titlebar">
    <span class="tb-icon" aria-hidden="true">🔐</span>
    <span class="tb-title"><%= t('admin.login_warning') %></span>
    <nav class="tb-lang" aria-label="<%= t('bar.language') %>">
      <% langs.forEach(function (l) { %>
        <a href="<%= adminPath %>/login?lang=<%= l.code %>" hreflang="<%= l.code %>" lang="<%= l.code %>"<%= l.code === locale ? ' aria-current="true" class="on"' : '' %>><%= l.label %></a>
      <% }) %>
    </nav>
  </div>
  <div class="login-body-inner">
    <pre class="ascii-art" style="font-size:10px" aria-hidden="true">
┌──────────────────────────────┐
│  ▓▓▓  OLDIE  ADMIN  v0.1  ▓▓▓ │
│    <  authorised users    >   │
└──────────────────────────────┘</pre>

    <% if (mustChange) { %>
      <div class="alert warn"><%= t('admin.login_temp_password') %></div>
    <% } %>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>

    <form method="post" action="<%= adminPath %>/login" class="login-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="row">
        <label for="username"><%= t('admin.username') %></label>
        <input id="username" name="username" autocomplete="username" required autofocus value="<%= form.username || 'admin' %>">
      </div>
      <div class="row">
        <label for="password"><%= t('admin.password_field') %></label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn primary" type="submit"><%= t('admin.sign_in') %></button>
    </form>

    <p class="mono" style="font-size:11px;text-align:center;margin-top:14px"><%= t('admin.login_no_account') %></p>
    <p class="center"><a href="/" class="mono">◀ <%= site.title %></a></p>
  </div>
  <div class="statusbar">
    <span>● <%= locale === 'en' ? 'WAITING FOR INPUT' : '等待输入' %></span>
    <span class="grow mono">POST /admin/login</span>
  </div>
</div>
</body>
</html>
