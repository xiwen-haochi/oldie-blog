<div class="admin-head">
  <h1>🖼 <%= t('admin.media_title') %></h1>
  <div class="flex" style="gap:10px">
    <span class="form-note"><%= t('admin.media_files', { n: files.length }) %></span>
    <span class="stamp"><%= storage.label %> · <%= storage.detail %></span>
  </div>
</div>

<form method="post" action="<%= adminPath %>/media" enctype="multipart/form-data" class="upload-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid-2">
    <div class="field">
      <label for="file"><%= t('admin.upload_file') %></label>
      <input id="file" type="file" name="file" accept="image/*">
    </div>
    <div class="field">
      <label for="dataUrl"><%= t('admin.paste_data_url') %></label>
      <textarea id="dataUrl" name="dataUrl" rows="2" placeholder="data:image/png;base64,…" data-paste-target></textarea>
    </div>
  </div>
  <div class="btn-row">
    <button class="btn primary" type="submit"><%= t('admin.upload') %></button>
    <span class="form-note"><%= t('admin.upload_types') %></span>
  </div>
</form>

<div class="upload-grid big">
  <% files.forEach(function (u) { %>
    <figure class="upload-item">
      <img src="<%= u.url %>" alt="<%= u.name %>" loading="lazy">
      <figcaption class="mono">
        <a href="<%= u.url %>" target="_blank" rel="noopener"><%= u.name %></a><br>
        <%= humanBytes(u.size) %> · <%= formatDate(u.mtime, { locale: dateLocale }) %>
        <form method="post" action="<%= adminPath %>/media/delete" data-confirm="<%= t('admin.delete_confirm', { slug: u.name }) %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="name" value="<%= u.name %>">
          <input type="hidden" name="key" value="<%= u.key %>">
          <button class="btn tiny danger" type="submit">🗑</button>
        </form>
      </figcaption>
    </figure>
  <% }) %>
  <% if (!files.length) { %><div class="alert"><%= t('admin.media_none') %></div><% } %>
</div>
