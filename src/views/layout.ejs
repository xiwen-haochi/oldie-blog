<!DOCTYPE html>
<html lang="<%= localeMeta.htmlLang %>" dir="<%= localeMeta.dir || 'ltr' %>" data-theme="classic" data-age="<%= site.theme.agePhotos ? '1' : '0' %>">
<head>
<%- include('partials/head') %>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="tm-banner">
  ⚠ <%= t('time_machine.banner') %>
  <a href="#" data-toggle-theme><%= t('time_machine.back') %></a>
</div>

<% if (site.theme.showMarquee && (site.banners || []).length) { %>
<div class="marquee-bar" aria-hidden="true">
  <div class="track">
    <% site.banners.forEach(function (b) { %>
      <span><% if (b.href && b.href !== '#') { %><a href="<%= b.href %>"><%= b.text %></a><% } else { %><%= b.text %><% } %></span>
    <% }) %>
  </div>
</div>
<% } %>

<div class="desktop">
  <div class="browser">
    <%- include('partials/header') %>
    <div class="win-body">
      <%- include('partials/sidebar') %>
      <main class="content" id="main">
        <%- bodyHtml %>
      </main>
    </div>
    <%- include('partials/statusbar') %>
    <%- include('partials/footer') %>
  </div>
</div>

<% if (site.theme.showTerminal) { %><%- include('partials/dock') %><% } %>
<script id="i18n-data" type="application/json"><%- JSON.stringify(clientStrings) %></script>
<script src="/js/site.js?v=<%= site.assetV %>" defer></script>
<% if (site.analytics) { %><%- site.analytics %><% } %>
</body>
</html>
