<div class="breadcrumbs"><a href="/">index.html</a><span class="sep">\</span> tags.html</div>
<section class="page-head">
  <h1 class="ph-title">🏷 Tag cloud</h1>
  <div class="ph-body"><p style="margin:0"><%= tags.length %> topic<%= tags.length === 1 ? '' : 's' %> in use. Bigger words = bigger ego.</p></div>
</section>

<% if (tags.length) { %>
<div class="tagcloud" style="font-size:14px">
  <% tags.forEach(function (t) { %>
    <a class="tag-pill" style="font-size:<%= Math.min(13 + t.count, 20) %>px" href="/tags/<%= t.slug %>">
      <%= t.name %> <span class="n"><%= t.count %></span>
    </a>
  <% }) %>
</div>

<table class="table" style="margin-top:18px">
  <thead><tr><th>Tag</th><th>Posts</th><th>Newest</th><th>Feed</th></tr></thead>
  <tbody>
    <% tags.forEach(function (t) { %>
      <tr>
        <td><a href="/tags/<%= t.slug %>"><strong><%= t.name %></strong></a></td>
        <td><%= t.count %></td>
        <td class="mono" style="font-size:11px"><%= formatDate(t.posts[0].date, { locale: site.locale }) %></td>
        <td><a class="btn tiny" href="/feed/tag/<%= t.slug %>.xml">RSS</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } else { %>
<div class="alert warn">No tags yet. Add <code>tags: [foo, bar]</code> to a post's front matter.</div>
<% } %>
