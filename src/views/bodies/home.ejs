<div class="breadcrumbs"><a href="/">index.html</a><span class="sep">\</span> home</div>

<section class="page-head">
  <h1 class="ph-title">🏠 <%= t('home.welcome') %></h1>
  <div class="ph-body">
    <p style="margin:0 0 6px"><strong><%= site.tagline %></strong></p>
    <p style="margin:0" class="mono" style="font-size:11px">
      <%= t('home.visitor_line', { total: stats.total, since, posts: postCount, guestbook: guestbookCount }) %>
    </p>
  </div>
</section>

<% if (featured && featured.length) { %>
<section style="margin-bottom:18px">
  <h2 style="font-family:var(--font-ui);font-size:13px;margin:0 0 8px" class="widget-title">⭐ <%= t('home.featured') %></h2>
  <ul class="post-list">
    <% featured.forEach(function (post) { %><%- include('../partials/post-card', { post }) %><% }) %>
  </ul>
</section>
<% } %>

<h2 style="font-family:var(--font-ui);font-size:13px;margin:16px 0 8px" class="widget-title">📬 <%= t('home.latest') %></h2>

<% if (pager.items.length) { %>
<ul class="post-list">
  <% pager.items.forEach(function (post) { %><%- include('../partials/post-card', { post }) %><% }) %>
</ul>
<%- include('../partials/pager', { pager, pagerUrl }) %>
<% } else { %>
<div class="alert warn">
  <b>📭 <%= t('home.empty') %></b>
</div>
<% } %>

<div class="grid-2" style="margin-top:18px">
  <div class="widget">
    <h3 class="widget-title">📌 <%= t('home.whats_new') %></h3>
    <div class="widget-body">
      <ul>
        <li>✔ <span class="blink">NEW</span> <%= locale === 'en' ? 'chiptune theme player — synthesized live in your browser, zero downloads' : '芯片音乐主题 —— 浏览器现场合成，零下载' %></li>
        <li>✔ <%= locale === 'en' ? 'DOS terminal on every page — press Ctrl+K, type help' : '每个页面都有 DOS 终端 —— 按 Ctrl+K 输入 help' %></li>
        <li>✔ <%= locale === 'en' ? 'every post can be downloaded as a plain .TXT file' : '每篇文章都能下载成纯文本 .TXT' %></li>
        <li>✔ <%= locale === 'en' ? 'posts authored in Markdown, served as fast, crawlable HTML' : '用 Markdown 写，吐出快速、可抓取的 HTML' %></li>
      </ul>
      <div class="linkbar">
        <a class="btn tiny" href="/random">🎲 <%= t('side.random') %></a>
        <a class="btn tiny" href="/archive">🗄 <%= t('archive.title').replace(/^[^ ]+ /, '') %></a>
      </div>
    </div>
  </div>

  <div class="widget">
    <h3 class="widget-title">🖥 <%= t('home.live_desk') %></h3>
    <div class="widget-body">
      <div class="ascii-art" style="font-size:9px;line-height:1.1" aria-label="ASCII art of a desk">
<%= [
'    ┌──────────────┐',
'    │ ▓▓▓▓  ░░░░░  │',
'    │ ▓▓▓▓▓▓▓▓░░░░ │  ← 1440x900 of pure',
'    │ ░░░░░░░░░░░░ │    procrastination',
'    └──────┬───────┘',
'           │',
'    ╔══════╧══════╗',
'    ║  COFFEE ☕   ║',
'    ╚══════╤══════╝',
'           ▼',
].join('\n') %>
      </div>
      <p class="mono" style="font-size:10px;margin:6px 0 0">
        <% if (stats.online > 0) { %>
          <%= t('home.visitor_count', { n: stats.online }) %>
        <% } else { %>
          📡 <%= t('home.wires_quiet') %> <a href="/guestbook"><%= t('gb.title').replace(/^[^ ]+ /, '') %></a>
        <% } %>
      </p>
    </div>
  </div>
</div>

<div class="alert" style="margin-top:16px;background:#fffbe6">
  <b>⚡ <%= t('home.ps') %>:</b> <%= locale === 'en'
    ? 'this site renders entirely on the server in a few milliseconds. No hydration, no client framework, no trackers. Just <table>-era honesty with a modern SEO layer.'
    : '整站纯服务端渲染，几毫秒出结果。没有 hydration，没有前端框架，没有追踪器——只有 90 年代的实在，加上现代 SEO。' %>
</div>
