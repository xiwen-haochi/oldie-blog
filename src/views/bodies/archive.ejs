<div class="breadcrumbs"><a href="/">index.html</a><span class="sep">\</span> archive.html</div>
<section class="page-head">
  <h1 class="ph-title">🗄 <%= t('archive.title') %></h1>
  <div class="ph-body">
    <p style="margin:0">
      <%= t('archive.summary', {
        posts: totalCount,
        years: timeline.length,
        words: totalWords.toLocaleString('en-US'),
        first: oldest ? formatDate(oldest.date, { locale: dateLocale }) : '—'
      }) %>
    </p>
  </div>
</section>

<% if (tags.length) { %>
<div class="widget">
  <h3 class="widget-title">🏷 <%= t('archive.jump') %></h3>
  <div class="widget-body">
    <div class="tagcloud">
      <% tags.forEach(function (tg) { %>
        <a class="tag-pill" href="/tags/<%= tg.slug %>"><%= tg.name %> <span class="n">[<%= tg.count %>]</span></a>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<% timeline.forEach(function (y) { %>
<section class="timeline-year">
  <h3>📅 <%= y.year %> <span style="font-weight:400;font-size:11px">(<%= y.count %>)</span></h3>
  <% y.months.forEach(function (m) { %>
    <div class="tl-month">
      <h4><%= locale === 'en' ? monthName(m.month) : (m.month + ' 月') %> <%= y.year %></h4>
      <% m.posts.forEach(function (p) { %>
        <div class="tl-item">
          <span class="when"><%= pad(p.date.getUTCDate()) %></span>
          <span><a href="<%= p.url %>"><%= p.title %></a> <span class="muted mono" style="font-size:11px">· <%= p.readingTime %> <%= t('card.min') %></span></span>
        </div>
      <% }) %>
    </div>
  <% }) %>
</section>
<% }) %>
