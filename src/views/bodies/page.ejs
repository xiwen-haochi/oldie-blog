<div class="breadcrumbs"><a href="/">index.html</a><span class="sep">\</span> <%= doc.slug %>.html</div>
<article class="article">
  <header class="article-header">
    <h1 class="article-title"><%= doc.title %></h1>
    <div class="article-meta">
      <span>📅 <%= t('side.last_updated') %> <%= formatDate(doc.updated || doc.date, { locale: dateLocale }) %></span>
      <span>⏱ <%= doc.readingTime %> <%= t('post.min_read') %></span>
      <% doc.tags.forEach(function (tag) { %><a class="tag" href="/tags/<%= slugify(tag) %>">#<%= tag %></a><% }) %>
    </div>
  </header>
  <%# the cover was stored and used for og:image, but nothing ever drew it %>
  <% if (doc.cover) { %>
    <figure class="article-cover">
      <img src="<%= doc.cover %>" alt="<%= doc.coverAlt || doc.title %>">
    </figure>
  <% } %>
  <div class="prose" data-post-body><%- doc.html %></div>
  <div class="post-footer">
    <div class="linkbar">
      <a class="btn tiny" href="#" data-listen-post><%= t('post.listen') %></a>
      <a class="btn tiny" href="#" data-copy="<%= page.canonicalUrl %>"><%= t('post.copy') %></a>
      <a class="btn tiny" href="/" data-scroll-top>▲ <%= t('side.back_to_top') %></a>
    </div>
  </div>
</article>
