<div class="breadcrumbs"><a href="/">index.html</a><span class="sep">\</span> posts.md</div>
<section class="page-head">
  <h1 class="ph-title">📚 <%= t('posts.title') %></h1>
  <div class="ph-body">
    <p style="margin:0"><%= t('posts.showing', { from: pager.range[0], to: pager.range[1], total: pager.total }) %></p>
  </div>
</section>

<% if (pager.items.length) { %>
<ul class="post-list">
  <% pager.items.forEach(function (post) { %><%- include('../partials/post-card', { post }) %><% }) %>
</ul>
<%- include('../partials/pager', { pager, pagerUrl }) %>
<% } else { %>
<div class="alert warn"><%= t('posts.none') %> <a href="/"><%= t('404.home').replace(/^[^ ]+ /, '') %></a>.</div>
<% } %>
