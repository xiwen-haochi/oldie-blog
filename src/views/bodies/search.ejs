<div class="breadcrumbs"><a href="/">index.html</a><span class="sep">\</span> find.html</div>
<section class="page-head">
  <h1 class="ph-title">🔍 Search this site</h1>
  <div class="ph-body">
    <p style="margin:0 0 8px">Type in the box. Press <kbd>Ctrl</kbd>+<kbd>K</kbd> anywhere to jump back here.</p>
    <form class="search-box" method="get" action="/search" role="search">
      <input type="search" name="q" value="<%= query %>" placeholder="markdown, 1998, webring…" aria-label="search query" autocomplete="off" id="q">
      <button class="btn" type="submit">🔎 SEARCH</button>
      <% if (query) { %><a class="btn" href="/search">CLEAR</a><% } %>
    </form>
    <p class="form-note" style="margin:8px 0 0">
      Operators: <code>tag:markdown</code> · <code>"exact phrase"</code> · <code>-exclude</code> · <code>in:title</code>
    </p>
  </div>
</section>

<% if (!query) { %>
  <div class="grid-2">
    <div class="widget">
      <h3 class="widget-title">🔥 Popular tags</h3>
      <div class="widget-body">
        <div class="tagcloud">
          <% tags.slice(0, 14).forEach(function (t) { %>
            <a class="tag-pill" href="/tags/<%= t.slug %>"><%= t.name %> <span class="n"><%= t.count %></span></a>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="widget">
      <h3 class="widget-title">⌨ Try these</h3>
      <div class="widget-body">
        <ul>
          <li><a href="/search?q=tag:web-design">tag:web-design</a></li>
          <li><a href="/search?q=%22Time+Machine%22">"Time Machine"</a></li>
          <li><a href="/search?q=in:title+markdown">in:title markdown</a></li>
          <li><a href="/search?q=chiptune+-synth">chiptune -synth</a></li>
        </ul>
      </div>
    </div>
  </div>
<% } else if (!results.length) { %>
  <div class="alert warn">
    <b>❌ 0 hits for "<%= query %>".</b><br>
    The search index covers titles, tags, descriptions and full body text of all
    <%= postCount %> published posts. Try a shorter query or drop a filter.
  </div>
<% } else { %>
  <p class="mono" style="font-size:12px"><%= results.length %> result<%= results.length === 1 ? '' : 's' %> for "<strong><%= query %></strong>" · <a href="/feed.xml">subscribe instead</a></p>
  <% results.forEach(function (r) { %>
    <div class="result">
      <h3><a href="<%= r.url %>"><%= r.title %></a></h3>
      <div class="url"><%= site.url.replace(/^https?:\/\//, '') %><%= r.url %></div>
      <p class="snip"><%- r.snippet %></p>
      <div class="post-meta">
        <span>📅 <%= formatDate(r.date, { locale: site.locale }) %></span>
        <span>⏱ <%= r.readingTime %> min</span>
        <% r.tags.forEach(function (t) { %><a class="tag" href="/tags/<%= slugify(t) %>"><%= t %></a><% }) %>
      </div>
    </div>
  <% }) %>
<% } %>
