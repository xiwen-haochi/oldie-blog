node_modules/
.env
.DS_Store
*.log
coverage/

# runtime state: hit counter, guestbook, sessions, subscribers, settings.
# *.tmp too: the JSON store writes <file>.json.<pid>.<ts>.tmp while saving and
# those files contain the same (personal) data as the file they replace.
data/*.json
data/*.json.*
data/*.tmp
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.bak
!data/.gitkeep

# generated admin credentials — never commit these
config/admin.json

# secrets that can also live in a .env or a config override
.env
.env.*

# uploads are yours, keep them out of the history unless you want them
public/uploads/*
!public/uploads/.gitkeep
.cache/

# restore scratch space (a restore moves the old files here first)
.before-restore-*/
.restore-staging-*/
content/.backup-*/
